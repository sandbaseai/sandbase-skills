{
  "schema_version": 1,
  "id": "market-signal-monitor",
  "display_name": "Market Signal Monitor",
  "short_description": "Monitor non-financial category and audience signals.",
  "description": "Build a time-bounded brief from web, public community, company-news, and search-interest signals.",
  "category": {"id": "marketing-research", "label": "Marketing & Research"},
  "tags": ["market research", "trends", "competitive intelligence"],
  "version": "0.1.0",
  "status": "active",
  "visibility": "public",
  "examples": ["Create a weekly market-signal brief for AI agent observability.", "Identify converging launch and buyer-demand signals for a product category."],
  "api": {
    "gateway": "sandbase-mcp",
    "pricing_model": "usage-based/call",
    "schema_resolution": {"source": "sandbase-capability-registry", "strategy": "dynamic", "lookup": "sandbase_describe_tool"},
    "endpoints": [
      {"method": "POST", "operation": "exa/search", "tool_name": "exa_search", "summary": "Find current web signals."},
      {"method": "POST", "operation": "cloudsway/search", "tool_name": "cloudsway_search", "summary": "Find complementary web signals."},
      {"method": "POST", "operation": "akta/news", "tool_name": "akta_news", "summary": "Find company and industry news."},
      {"method": "POST", "operation": "reddit/dynamic-search", "tool_name": "reddit_app_dynamic_search", "summary": "Find public community discussion."},
      {"method": "POST", "operation": "dataforseo/v3/keywords_data/google_trends/explore/live", "tool_name": "dataforseo_v3_keywords_data_google_trends_explore_live", "summary": "Inspect search-interest movement."}
    ]
  },
  "related_skills": ["reddit-customer-insights", "competitor-content-intelligence"]
}
